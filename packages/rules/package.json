{
  "name": "@integration-doctor/rules",
  "version": "0.1.0",
  "private": true,
  "description": "The checks and the DHL error catalogue behind Integration Doctor for DHL APIs. Runs in Node and in the browser.",
  "type": "module",
  "main": "dist/index.js",
