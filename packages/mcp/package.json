{
  "name": "@integration-doctor/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for Integration Doctor for DHL APIs: lets an AI assistant check DHL requests, explain DHL errors and, with your own key, make read-only live checks from your machine.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "integration-doctor-mcp": "dist/src/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@integration-doctor/rules": "*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
